{
  "name": "sistem-administrasi-pmii-rayon",
  "version": "1.0.0",
  "description": "Aplikasi Web Lokal Sistem Administrasi PMII Rayon - Surat, Proposal, LPJ, Data Kader, dan Arsip",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
